<Window x:Class="StadOntwikkeling_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StadsOntwikkelingen"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FB">

	<Window.Resources>
		<DropShadowEffect x:Key="DropShadowEffect"
                          Color="Black"
                          BlurRadius="20"
                          ShadowDepth="3"
                          Opacity="0.25"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Card -->
		<Border Grid.Row="1"
                Background="White"
                CornerRadius="20"
                Padding="40"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Effect="{StaticResource DropShadowEffect}">

			<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">

				<TextBlock Text="Welkom!"
                           Foreground="#009DE0"
                           FontSize="36"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"/>

				<TextBlock Text="Emailadres"
                           Foreground="#009DE0"
                           FontSize="18"
                           Margin="0 0 0 5"/>

				<TextBox x:Name="Email_TextBox"
                         Height="45"
                         FontSize="20"
                         Foreground="#009DE0"
                         Padding="10"
                         Margin="0 0 0 20"/>

				<Button x:Name="Login"
                        Content="Login"
                        Height="50"
                        FontSize="20"
                        Background="#009DE0"
                        Foreground="White"
                        BorderBrush="#009DE0"
                        Cursor="Hand"
                        Click="Login_Click"
                        Margin="0 10 0 0">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
								<ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>

			</StackPanel>

		</Border>

	</Grid>
</Window>
