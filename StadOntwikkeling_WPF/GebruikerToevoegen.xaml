<Window x:Class="StadOntwikkeling_WPF.GebruikerToevoegen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gebruiker Toevoegen" Height="600" Width="1000"
        ResizeMode="NoResize"
        Background="#F4F6F8">

	<!-- Resources voor styling -->
	<Window.Resources>
		<SolidColorBrush x:Key="PrimaryColor" Color="#009DE0"/>
		<SolidColorBrush x:Key="AccentColor" Color="#007BB5"/>
		<Style TargetType="TextBlock" x:Key="HeaderText">
			<Setter Property="Foreground" Value="{StaticResource PrimaryColor}" />
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>

		<!-- Style voor TextBoxes met ronde hoeken via Border -->
		<Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="Foreground" Value="#333"/>
			<Setter Property="Background" Value="White"/>
		</Style>

		<!-- Buttons met ronde hoeken en hover effect -->
		<Style TargetType="Button">
			<Setter Property="Width" Value="200"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Margin" Value="8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#005C90"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- CheckBoxes style -->
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Margin" Value="0,0,20,0"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Titel -->
		<TextBlock Grid.Row="0"
                   Text="Gebruiker toevoegen"
                   Foreground="{StaticResource PrimaryColor}"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,20" />

		<!-- Formulier -->
		<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">

			<TextBlock Text="Naam" Style="{StaticResource HeaderText}"/>
			<Border CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource PrimaryColor}" Margin="0,0,0,16">
				<TextBox x:Name="NaamTextBox" Style="{StaticResource RoundedTextBoxStyle}"/>
			</Border>

			<TextBlock Text="Emailadres" Style="{StaticResource HeaderText}"/>
			<Border CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource PrimaryColor}" Margin="0,0,0,16">
				<TextBox x:Name="EmailTextBox" Style="{StaticResource RoundedTextBoxStyle}"/>
			</Border>

			<StackPanel Orientation="Horizontal" Margin="0,16,0,0">
				<CheckBox x:Name="IsAdminCheckBox" Content="Is admin"/>
				<CheckBox x:Name="IsPartnerCheckBox" Content="Is partner"/>
			</StackPanel>
		</StackPanel>

		<!-- Knoppen -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30">
			<Button x:Name="SaveButton" Content="Opslaan"/>
			<Button x:Name="CancelButton" Content="Annuleren" 
                    Background="White" 
                    Foreground="{StaticResource PrimaryColor}" 
                    BorderBrush="{StaticResource PrimaryColor}"/>
		</StackPanel>
	</Grid>
</Window>
