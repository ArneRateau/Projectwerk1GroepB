<Window x:Class="StadOntwikkeling_WPF.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainMenu"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FB">

	<Window.Resources>
		<DropShadowEffect x:Key="Shadow"
                          Color="Black"
                          BlurRadius="20"
                          ShadowDepth="3"
                          Opacity="0.25"/>

		<!-- Herbruikbare button style -->
		<Style x:Key="RoundedButton" TargetType="Button">
			<Setter Property="Background" Value="#009DE0"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#009DE0"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="Width" Value="220"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto"/>
			<RowDefinition />
		</Grid.RowDefinitions>

		<Border Grid.Row="1"
                Background="White"
                CornerRadius="20"
                Padding="40"
                Width="550"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Effect="{StaticResource Shadow}">

			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

				<TextBlock Text="Welkom, gebruiker!"
                           Foreground="#009DE0"
                           FontSize="36"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 15"/>

				<TextBlock Text="Wat wenst u te doen?"
                           Foreground="#009DE0"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

				<StackPanel Orientation="Vertical" HorizontalAlignment="Center">

					<Button x:Name="Bekijk"
                            Content="Bekijk projecten"
                            Style="{StaticResource RoundedButton}"
                            Margin="0 0 0 15"
                            Click="BekijkProjecten_Click"/>

					<Button x:Name="MaakProject"
                            Content="Maak nieuw project"
                            Style="{StaticResource RoundedButton}"
                            Margin="0 0 0 15"
                            Click="MaakProject_Click"/>

					<Button x:Name="addGebruiker"
                            Content="Maak gebruiker"
                            Style="{StaticResource RoundedButton}"
                            Click="MaakGebruiker_Click"/>
				</StackPanel>

			</StackPanel>

		</Border>

	</Grid>
</Window>
